<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Task List</title>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
            rel="stylesheet"
        />
        <style>
            #progress-container {
                width: 100%;
                background-color: #e9ecef;
                border-radius: 0.25rem;
                overflow: hidden;
                height: 30px;
            }

            #progress-bar {
                width: 0%;
                background-color: rgb(96, 249, 96);
                color: white;
                text-align: center;
                line-height: 30px;
                transition: width 0.2s;
            }
        </style>
    </head>
    <body class="p-4">
        <div class="container">
            <h1 class="mb-4">Task List</h1>

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <div class="card p-3">
                        <h2 class="card-title">Server Time</h2>
                        <div id="time" class="fs-4">Loading...</div>
                    </div>
                </div>

                <div class="container">
                    <h1>Upload a File</h1>

                    <form id="upload-form">
                        <div class="mb-3">
                            <input
                                type="file"
                                name="file"
                                id="file"
                                class="form-control"
                                required
                            />
                        </div>
                        <button type="submit" class="btn btn-primary">
                            Upload
                        </button>
                    </form>

                    <div id="progress-container">
                        <div id="progress-bar">0%</div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <a href="/tasks/new" class="btn btn-success">Create New Task</a>
            </div>

            <ul class="list-group">
                <% tasks.forEach(task => { %>
                <li
                    class="list-group-item d-flex justify-content-between align-items-center"
                >
                    <div>
                        <strong><%= task.title %></strong> - <%= task.status %>
                        - <%= task.priority %>
                    </div>
                    <div>
                        <a
                            href="tasks/<%= task.id %>/edit"
                            class="btn btn-sm btn-warning me-2"
                            >EDIT</a
                        >
                        <a
                            href="tasks/<%= task.id %>"
                            class="btn btn-sm btn-info text-white"
                            >VIEW</a
                        >
                    </div>
                </li>
                <% }) %>
            </ul>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            async function fetchServerTime() {
                try {
                    const res = await fetch("/time");
                    const data = await res.json();
                    document.getElementById("time").innerText = data.time;
                } catch (err) {
                    document.getElementById("time").innerText = "Error";
                }
            }

            fetchServerTime();
            setInterval(fetchServerTime, 1000);

            const form = document.getElementById("upload-form");
            const progressBar = document.getElementById("progress-bar");
            const message = document.getElementById("message");

            form.addEventListener("submit", (e) => {
                e.preventDefault();

                const file = document.getElementById("file").files[0];
                if (!file) return;

                const formData = new FormData();
                formData.append("file", file);

                const xhr = new XMLHttpRequest();
                xhr.open("POST", "/upload");

                xhr.upload.addEventListener("progress", (e) => {
                    if (e.lengthComputable) {
                        const percent = Math.floor((e.loaded / e.total) * 100);
                        progressBar.style.width = percent + "%";
                        progressBar.textContent = percent + "%";
                    }
                });

                xhr.onload = () => {
                    if (xhr.status === 200) {
                        progressBar.style.width = "0%";
                        progressBar.textContent = "0%";
                        form.reset();
                    } else {
                        message.innerHTML = `<div class="alert alert-danger">Upload failed</div>`;
                    }
                };

                xhr.send(formData);
            });
        </script>
    </body>
</html>
